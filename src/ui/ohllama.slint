// ohllama GUI — Claude design language, three pages (Engines / Models / Chat).
//
// Slint 1.18 (customized fork) rules honored (verified by probe builds + live
// screenshots):
//   - no `layout: grow`, no mixed-unit math (`100% - 12px`), no 4-value border-width,
//     no `animation` element, no Text alignment property.
//   - In a HorizontalLayout a `width: 100%` child overflows when it also has
//     fixed-width siblings -> use FIXED widths that sum within the available
//     space. (height:100% in a HorizontalLayout is safe.)
//   - In a VerticalLayout a `height: 100%` child overflows when it also has
//     fixed-height siblings -> use a FIXED height. (width:100% in a
//     VerticalLayout is safe.)
//   - All interactive controls are a custom `ClaudeButton` because this fork's
//     std-widgets Button cannot be recolored.
//   - Page switching crossfades via `content_opacity` (Rust-tweened), since the
//     fork has no declarative animation.
//
// Palette (Claude): warm cream background, charcoal ink, terracotta accent.
// Content region is a fixed 641px-tall band (nav is 59px, window is 700px).

import { ScrollView, LineEdit } from "std-widgets.slint";

// --------------------------------------------------------------- custom bits
// A recolorable pill / rounded button built from primitives.
component ClaudeButton {
    in property <string> label: "";
    in property <color> bg: #f5f4ef;
    in property <color> fg: #3d3c39;
    in property <color> bd: #f5f4ef;
    in property <length> bw: 0px;
    in property <length> radius: 8px;
    in property <length> fs: 13px;
    in property <length> ty: 6px;
    callback clicked();

    width: 90px;
    height: 30px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg;
        border-color: root.bd;
        border-width: root.bw;
        border-radius: root.radius;
        clip: true;
    }
    Text {
        x: 0px;
        y: root.ty;
        width: 100%;
        text: root.label;
        color: root.fg;
        font-size: root.fs;
        font-weight: 600;
        horizontal-alignment: center;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

// --------------------------------------------------------------- row types
export struct EngineRow {
    name: string,
    present: bool,
    precompiled: bool,
    is_default: bool,
    recommended: bool,
    path: string,
    note: string,
}

export struct ModelRow {
    name: string,
    provider: string,
    rec_quant: string,
    rec_quant_size: string,
    ttft: string,
    tpot: string,
    total: string,
    status_color: color,
    status_label: string,
    repo_id: string,
}

export struct QuantRow {
    quant: string,
    bits: string,
    vram: string,
    quality: string,
    status: string,
    status_color: color,
}

export struct FileRow {
    name: string,
    size: string,
}

export struct ChatMsg {
    role: string,
    content: string,
}

// ------------------------------------------------------------------ the app
export component Main inherits Window {
    title: "ohllama";
    width: 980px;
    height: 700px;
    background: #f5f4ef;

    in-out property <int> page: 0;
    // Crossfade strength of the content region (Rust tweens it on switch).
    in property <float> content_opacity: 1.0;

    in property <[EngineRow]> engines: [];
    in property <string> hw_summary: "";
    in property <string> rec_engine: "";
    in property <string> rec_backend: "";
    in property <string> default_engine: "";

    in property <[ModelRow]> models: [];
    in-out property <string> category: "hot";
    in-out property <string> search_query: "";
    in property <bool> models_loading: false;

    in property <bool> detail_visible: false;
    in property <string> detail_repo: "";
    in property <string> detail_provider: "";
    in property <string> detail_desc: "";
    in property <string> detail_rec_quant: "";
    in property <[QuantRow]> quant_table: [];
    in property <[FileRow]> file_list: [];

    in property <[ChatMsg]> chat: [];
    in property <string> chat_model: "";
    in property <string> chat_status: "";
    in-out property <string> chat_input: "";

    callback change_engine(string, string);
    callback change_category(string);
    callback do_search(string);
    callback open_model(string);
    callback close_detail();
    callback download_model(string, string);
    callback send_chat(string);
    // Route page changes through Rust so the content region can crossfade.
    callback switch_page(int);

    // Top-level frame: nav band + a fixed 641px content band (59 + 641 = 700).
    Rectangle {
        width: 100%;
        height: 100%;

        // ============================ TOP NAV ============================
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 59px;
            background: #f5f4ef;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 13px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 4px;
                        background: #d97757;
                    }
                    Text {
                        text: "ohllama";
                        color: #1f1e1c;
                        font-size: 16px;
                        font-weight: 700;
                    }
                }
                HorizontalLayout {
                    width: 260px;
                }
                ClaudeButton {
                    label: "Engines";
                    bg: root.page == 0 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 0 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 82px;
                    height: 34px;
                    clicked => {
                        root.switch_page(0);
                    }
                }
                ClaudeButton {
                    label: "Models";
                    bg: root.page == 1 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 1 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 74px;
                    height: 34px;
                    clicked => {
                        root.switch_page(1);
                    }
                }
                ClaudeButton {
                    label: "Chat";
                    bg: root.page == 2 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 2 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 58px;
                    height: 34px;
                    clicked => {
                        root.switch_page(2);
                    }
                }
            }
            Rectangle {
                x: 0px;
                y: 58px;
                width: 100%;
                height: 1px;
                background: #e8e5db;
            }
        }

        // ====================== CONTENT (crossfade) ===================
        Rectangle {
            x: 0px;
            y: 59px;
            width: 100%;
            height: 641px;
            opacity: root.content_opacity;

            // ------------------------------------------------- PAGE 1 ENGINES
            Rectangle {
                visible: root.page == 0;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        Text {
                            text: "Engines";
                            color: #1f1e1c;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.engines.length + " available";
                            color: #a39e90;
                            font-size: 13px;
                        }
                    }
                    Text {
                        text: "Hardware · " + root.hw_summary;
                        color: #7a7873;
                        font-size: 13px;
                        width: 100%;
                        max-lines: 1;
                    }

                    // recommendation card
                    Rectangle {
                        width: 100%;
                        height: 72px;
                        background: #ffffff;
                        border-color: #f0c4b3;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            width: 100%;
                            padding: 14px;
                            spacing: 6px;
                            Text {
                                text: "Recommended for this machine";
                                color: #c2664a;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: #d97757;
                                }
                                Text {
                                    text: root.rec_engine + "  ·  " + root.rec_backend;
                                    color: #1f1e1c;
                                    font-size: 18px;
                                    font-weight: 700;
                                    width: 320px;
                                    max-lines: 1;
                                }
                                Text {
                                    text: "default: " + (root.default_engine != "" ? root.default_engine : "none");
                                    color: #7a7873;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // engine cards (fixed height -> fits the 641px band)
                    ScrollView {
                        width: 100%;
                        height: 430px;
                        VerticalLayout {
                            width: 100%;
                            spacing: 10px;
                            for engine in root.engines:
                                Rectangle {
                                    width: 100%;
                                    height: 64px;
                                    background: #ffffff;
                                    border-color: #eae7dd;
                                    border-width: 1px;
                                    border-radius: 12px;
                                    clip: true;
                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding: 12px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: engine.present ? #4d9f5f : #e8e5db;
                                        }
                                        // fixed width leaves room for dot + button
                                        VerticalLayout {
                                            width: 770px;
                                            spacing: 3px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: engine.name;
                                                    color: #1f1e1c;
                                                    font-size: 15px;
                                                    font-weight: 600;
                                                    width: 200px;
                                                    max-lines: 1;
                                                }
                                                Text {
                                                    text: engine.is_default ? "★ default" : "";
                                                    color: #d97757;
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: engine.recommended ? "● recommended" : "";
                                                    color: #4d9f5f;
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: engine.present ? "installed" : "missing";
                                                    color: engine.present ? #4d9f5f : #f2903b;
                                                    font-size: 11px;
                                                }
                                            }
                                            Text {
                                                text: (engine.path != "" ? engine.path : engine.note);
                                                color: #a39e90;
                                                font-size: 12px;
                                                width: 770px;
                                                max-lines: 1;
                                            }
                                        }
                                        ClaudeButton {
                                            label: engine.present ? "Set default" : "Download";
                                            bg: engine.present ? #1f1e1c : #d97757;
                                            fg: white;
                                            radius: 8px;
                                            ty: 6px;
                                            width: 104px;
                                            height: 30px;
                                            clicked => {
                                                if (engine.present) {
                                                    root.change_engine("default", engine.name);
                                                } else {
                                                    root.change_engine("download", engine.name);
                                                }
                                            }
                                        }
                                    }
                                }
                        }
                    }
                }
            }

            // ------------------------------------------------- PAGE 2 MODELS
            Rectangle {
                visible: root.page == 1;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 14px;

                    // search + category pills (all fixed widths that fit 936px)
                    HorizontalLayout {
                        width: 100%;
                        spacing: 8px;
                        Rectangle {
                            width: 200px;
                            height: 34px;
                            background: #ffffff;
                            border-color: #eae7dd;
                            border-width: 1px;
                            border-radius: 10px;
                            clip: true;
                            LineEdit {
                                width: 100%;
                                height: 100%;
                                text: root.search_query;
                                placeholder-text: "Search HuggingFace";
                                edited => {
                                    root.search_query = self.text;
                                }
                            }
                        }
                        ClaudeButton {
                            label: "Search";
                            bg: #1f1e1c;
                            fg: white;
                            radius: 10px;
                            ty: 7px;
                            width: 64px;
                            height: 34px;
                            clicked => {
                                root.do_search(root.search_query);
                            }
                        }
                        ClaudeButton {
                            label: "Hot";
                            bg: root.category == "hot" ? #1f1e1c : #ffffff;
                            fg: root.category == "hot" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 48px;
                            height: 34px;
                            clicked => {
                                root.category = "hot";
                                root.change_category("hot");
                            }
                        }
                        ClaudeButton {
                            label: "Coding";
                            bg: root.category == "coding" ? #1f1e1c : #ffffff;
                            fg: root.category == "coding" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 62px;
                            height: 34px;
                            clicked => {
                                root.category = "coding";
                                root.change_category("coding");
                            }
                        }
                        ClaudeButton {
                            label: "Image";
                            bg: root.category == "image" ? #1f1e1c : #ffffff;
                            fg: root.category == "image" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 58px;
                            height: 34px;
                            clicked => {
                                root.category = "image";
                                root.change_category("image");
                            }
                        }
                        ClaudeButton {
                            label: "Video";
                            bg: root.category == "video" ? #1f1e1c : #ffffff;
                            fg: root.category == "video" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 58px;
                            height: 34px;
                            clicked => {
                                root.category = "video";
                                root.change_category("video");
                            }
                        }
                        ClaudeButton {
                            label: "Tiny";
                            bg: root.category == "tiny" ? #1f1e1c : #ffffff;
                            fg: root.category == "tiny" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 50px;
                            height: 34px;
                            clicked => {
                                root.category = "tiny";
                                root.change_category("tiny");
                            }
                        }
                    }

                    // list / detail overlap (fixed height so it fits the band)
                    Rectangle {
                        width: 100%;
                        height: 543px;
                        // ---- model list ----
                        Rectangle {
                            visible: !root.detail_visible;
                            width: 100%;
                            height: 100%;
                            ScrollView {
                                width: 100%;
                                height: 100%;
                                VerticalLayout {
                                    width: 100%;
                                    spacing: 8px;
                                    Text {
                                        visible: root.models_loading;
                                        text: "Loading models from HuggingFace…";
                                        color: #5f5e5b;
                                        font-size: 14px;
                                        width: 100%;
                                    }
                                    Text {
                                        visible: !root.models_loading && root.models.length == 0;
                                        text: "No models shown yet — pick a category or search.";
                                        color: #5f5e5b;
                                        font-size: 14px;
                                        width: 100%;
                                    }
                                    // header (fixed widths mirror the row columns)
                                    HorizontalLayout {
                                        visible: !root.models_loading;
                                        width: 100%;
                                        padding: 8px;
                                        spacing: 4px;
                                        Rectangle { width: 250px; clip: true; Text { text: "Model"; color: #a39e90; font-size: 11px; font-weight: 600; width: 244px; } }
                                        Rectangle { width: 130px; clip: true; Text { text: "Provider"; color: #a39e90; font-size: 11px; font-weight: 600; width: 124px; } }
                                        Rectangle { width: 70px; clip: true; Text { text: "Quant"; color: #a39e90; font-size: 11px; font-weight: 600; width: 64px; } }
                                        Rectangle { width: 70px; clip: true; Text { text: "Size"; color: #a39e90; font-size: 11px; font-weight: 600; width: 64px; } }
                                        Rectangle { width: 55px; clip: true; Text { text: "TTFT"; color: #a39e90; font-size: 11px; font-weight: 600; width: 49px; } }
                                        Rectangle { width: 55px; clip: true; Text { text: "TPOT"; color: #a39e90; font-size: 11px; font-weight: 600; width: 49px; } }
                                        Rectangle { width: 60px; clip: true; Text { text: "Total"; color: #a39e90; font-size: 11px; font-weight: 600; width: 54px; } }
                                        Rectangle { width: 200px; Text { text: "Status"; color: #a39e90; font-size: 11px; font-weight: 600; width: 100%; } }
                                    }
                                    for m in root.models:
                                        Rectangle {
                                            visible: !root.models_loading;
                                            width: 100%;
                                            height: 48px;
                                            background: #ffffff;
                                            border-color: #ece9e0;
                                            border-width: 1px;
                                            border-radius: 10px;
                                            clip: true;
                                            TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => {
                                                    root.open_model(m.repo_id);
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding: 8px;
                                                spacing: 4px;
                                                Rectangle {
                                                    width: 250px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.name;
                                                        color: #1f1e1c;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        width: 244px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 130px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.provider;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 124px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 70px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.rec_quant;
                                                        color: #c2664a;
                                                        font-size: 12px;
                                                        width: 64px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 70px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.rec_quant_size;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 64px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 55px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.ttft;
                                                        color: #5f5e5b;
                                                        font-size: 12px;
                                                        width: 49px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 55px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.tpot;
                                                        color: #5f5e5b;
                                                        font-size: 12px;
                                                        width: 49px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 60px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: m.total;
                                                        color: #5f5e5b;
                                                        font-size: 12px;
                                                        width: 54px;
                                                        max-lines: 1;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 200px;
                                                    height: 100%;
                                                    clip: true;
                                                    Text {
                                                        x: 0px;
                                                        y: 8px;
                                                        text: "● " + m.status_label;
                                                        color: m.status_color;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        width: 194px;
                                                        max-lines: 1;
                                                    }
                                                }
                                            }
                                        }
                                }
                            }
                        }

                        // ---- model detail ----
                        Rectangle {
                            visible: root.detail_visible;
                            width: 100%;
                            height: 100%;
                            ScrollView {
                                width: 100%;
                                height: 100%;
                                VerticalLayout {
                                    width: 100%;
                                    spacing: 14px;
                                    HorizontalLayout {
                                        width: 100%;
                                        spacing: 10px;
                                        ClaudeButton {
                                            label: "‹ Back";
                                            bg: #ffffff;
                                            fg: #3d3c39;
                                            bd: #eae7dd;
                                            bw: 1px;
                                            radius: 10px;
                                            ty: 6px;
                                            width: 64px;
                                            height: 30px;
                                            clicked => {
                                                root.close_detail();
                                            }
                                        }
                                        Text {
                                            text: root.detail_repo;
                                            color: #1f1e1c;
                                            font-size: 20px;
                                            font-weight: 700;
                                            width: 460px;
                                            max-lines: 1;
                                        }
                                        Text {
                                            text: root.detail_provider;
                                            color: #a39e90;
                                            font-size: 12px;
                                        }
                                    }
                                    Text {
                                        text: root.detail_desc;
                                        color: #7a7873;
                                        font-size: 13px;
                                        width: 100%;
                                        max-lines: 2;
                                    }

                                    // quantization table (fixed column widths)
                                    Rectangle {
                                        width: 100%;
                                        background: #ffffff;
                                        border-color: #eae7dd;
                                        border-width: 1px;
                                        border-radius: 12px;
                                        clip: true;
                                        VerticalLayout {
                                            width: 100%;
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Quantizations   ·   recommended: " + root.detail_rec_quant;
                                                color: #1f1e1c;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                spacing: 10px;
                                                Text { text: "Quant"; color: #a39e90; font-size: 11px; font-weight: 600; width: 120px; }
                                                Text { text: "Bits"; color: #a39e90; font-size: 11px; font-weight: 600; width: 80px; }
                                                Text { text: "VRAM"; color: #a39e90; font-size: 11px; font-weight: 600; width: 100px; }
                                                Text { text: "Quality"; color: #a39e90; font-size: 11px; font-weight: 600; width: 120px; }
                                                Text { text: "Status"; color: #a39e90; font-size: 11px; font-weight: 600; width: 180px; }
                                            }
                                            for q in root.quant_table:
                                                HorizontalLayout {
                                                    width: 100%;
                                                    spacing: 10px;
                                                    Text {
                                                        text: q.quant;
                                                        color: #1f1e1c;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        width: 120px;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: q.bits;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 80px;
                                                    }
                                                    Text {
                                                        text: q.vram;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 100px;
                                                    }
                                                    Text {
                                                        text: q.quality;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 120px;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: "● " + q.status;
                                                        color: q.status_color;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        width: 180px;
                                                        max-lines: 1;
                                                    }
                                                }
                                        }
                                    }

                                    // files & versions
                                    Rectangle {
                                        width: 100%;
                                        background: #ffffff;
                                        border-color: #eae7dd;
                                        border-width: 1px;
                                        border-radius: 12px;
                                        clip: true;
                                        VerticalLayout {
                                            width: 100%;
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Files & versions";
                                                color: #1f1e1c;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                            for f in root.file_list:
                                                HorizontalLayout {
                                                    width: 100%;
                                                    spacing: 10px;
                                                    Text {
                                                        text: f.name;
                                                        color: #3d3c39;
                                                        font-size: 12px;
                                                        width: 800px;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: f.size;
                                                        color: #a39e90;
                                                        font-size: 11px;
                                                        width: 80px;
                                                    }
                                                }
                                        }
                                    }

                                    ClaudeButton {
                                        label: "Download (" + root.detail_rec_quant + ")  ·  fastest mirror · 32/64 threads";
                                        bg: #d97757;
                                        fg: white;
                                        radius: 12px;
                                        ty: 9px;
                                        width: 100%;
                                        height: 38px;
                                        clicked => {
                                            root.download_model(root.detail_repo, root.detail_rec_quant);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------- PAGE 3 CHAT
            Rectangle {
                visible: root.page == 2;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 12px;

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #d97757;
                        }
                        Text {
                            text: root.chat_model;
                            color: #1f1e1c;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.chat_status;
                            color: #c2664a;
                            font-size: 12px;
                        }
                    }

                    // messages (fixed height leaves room for the composer below)
                    ScrollView {
                        width: 100%;
                        height: 470px;
                        VerticalLayout {
                            width: 100%;
                            spacing: 10px;
                            for msg in root.chat:
                                Rectangle {
                                    width: 100%;
                                    background: msg.role == "user" ? #1f1e1c : #ffffff;
                                    border-color: msg.role == "user" ? #1f1e1c : #eae7dd;
                                    border-width: msg.role == "user" ? 0px : 1px;
                                    border-radius: 14px;
                                    clip: true;
                                    VerticalLayout {
                                        width: 100%;
                                        padding: 12px;
                                        spacing: 4px;
                                        Text {
                                            text: msg.role;
                                            color: msg.role == "user" ? #f2903b : #c2664a;
                                            font-size: 11px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            width: 100%;
                                            text: msg.content;
                                            color: msg.role == "user" ? white : #1f1e1c;
                                            font-size: 14px;
                                        }
                                    }
                                }
                        }
                    }

                    // composer (kept visible: the message scroll no longer takes 100%)
                    Rectangle {
                        width: 100%;
                        height: 48px;
                        background: #ffffff;
                        border-color: #eae7dd;
                        border-width: 1px;
                        border-radius: 12px;
                        clip: true;
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding: 8px;
                            spacing: 8px;
                            LineEdit {
                                width: 850px;
                                height: 100%;
                                text: root.chat_input;
                                placeholder-text: "Message ohllama…";
                                edited => {
                                    root.chat_input = self.text;
                                }
                            }
                            ClaudeButton {
                                label: "Send";
                                bg: #d97757;
                                fg: white;
                                radius: 8px;
                                ty: 4px;
                                width: 56px;
                                height: 32px;
                                clicked => {
                                    root.send_chat(root.chat_input);
                                    root.chat_input = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
