// ohllama GUI — Claude design language, three pages (Engines / Models / Chat).
//
// Slint 1.18 (customized fork) constraints honored:
//   - unquoted hex colors; `color`/`length` in-props on custom components
//   - std-widgets Button is NOT recolorable here, so all interactive controls
//     are built from a custom `ClaudeButton` (Rectangle + Text + TouchArea)
//   - mutually-exclusive pages/sections overlap at (0,0) and toggle with
//     `visible` (no StackedLayout / fr in this build)
//   - rows are wrapped in a VerticalLayout so `for`-generated siblings flow
//     top-to-bottom instead of piling up.
//
// Palette (Claude): warm cream background, charcoal ink, terracotta accent.

import { ScrollView, LineEdit } from "std-widgets.slint";

// --------------------------------------------------------------- custom bits
// A recolorable pill / rounded button built from primitives.
component ClaudeButton {
    in property <string> label: "";
    in property <color> bg: #f5f4ef;
    in property <color> fg: #3d3c39;
    in property <color> bd: #f5f4ef;
    in property <length> bw: 0px;
    in property <length> radius: 8px;
    in property <length> fs: 13px;
    in property <length> ty: 6px;
    callback clicked();

    width: 90px;
    height: 30px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg;
        border-color: root.bd;
        border-width: root.bw;
        border-radius: root.radius;
        clip: true;
    }
    Text {
        x: 0px;
        y: root.ty;
        width: 100%;
        text: root.label;
        color: root.fg;
        font-size: root.fs;
        font-weight: 600;
    }
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

// --------------------------------------------------------------- row types
export struct EngineRow {
    name: string,
    present: bool,
    precompiled: bool,
    is_default: bool,
    recommended: bool,
    path: string,
    note: string,
}

export struct ModelRow {
    name: string,
    provider: string,
    rec_quant: string,
    rec_quant_size: string,
    ttft: string,
    tpot: string,
    total: string,
    status_color: color,
    status_label: string,
    repo_id: string,
}

export struct QuantRow {
    quant: string,
    bits: string,
    vram: string,
    quality: string,
    status: string,
    status_color: color,
}

export struct FileRow {
    name: string,
    size: string,
}

export struct ChatMsg {
    role: string,
    content: string,
}

// ------------------------------------------------------------------ the app
export component Main inherits Window {
    title: "ohllama";
    width: 980px;
    height: 700px;
    background: #f5f4ef;

    in-out property <int> page: 0;

    in property <[EngineRow]> engines: [];
    in property <string> hw_summary: "";
    in property <string> rec_engine: "";
    in property <string> rec_backend: "";
    in property <string> default_engine: "";

    in property <[ModelRow]> models: [];
    in-out property <string> category: "hot";
    in-out property <string> search_query: "";
    in property <bool> models_loading: false;

    in property <bool> detail_visible: false;
    in property <string> detail_repo: "";
    in property <string> detail_provider: "";
    in property <string> detail_desc: "";
    in property <string> detail_rec_quant: "";
    in property <[QuantRow]> quant_table: [];
    in property <[FileRow]> file_list: [];

    in property <[ChatMsg]> chat: [];
    in property <string> chat_model: "";
    in property <string> chat_status: "";
    in-out property <string> chat_input: "";

    callback change_engine(string, string);
    callback change_category(string);
    callback do_search(string);
    callback open_model(string);
    callback close_detail();
    callback download_model(string, string);
    callback send_chat(string);

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // ============================ TOP NAV ============================
        Rectangle {
            width: 100%;
            height: 58px;
            background: #f5f4ef;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding: 13px;
                spacing: 12px;

                // brand mark
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: 4px;
                        background: #d97757;
                    }
                    Text {
                        text: "ohllama";
                        color: #1f1e1c;
                        font-size: 16px;
                        font-weight: 700;
                    }
                }

                // spacer pushes the tabs to the right
                HorizontalLayout {
                    width: 240px;
                }

                // capsule tabs
                ClaudeButton {
                    label: "Engines";
                    bg: root.page == 0 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 0 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 82px;
                    height: 34px;
                    clicked => {
                        root.page = 0;
                    }
                }
                ClaudeButton {
                    label: "Models";
                    bg: root.page == 1 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 1 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 74px;
                    height: 34px;
                    clicked => {
                        root.page = 1;
                    }
                }
                ClaudeButton {
                    label: "Chat";
                    bg: root.page == 2 ? #1f1e1c : #f5f4ef;
                    fg: root.page == 2 ? white : #7a7873;
                    radius: 17px;
                    ty: 8px;
                    width: 58px;
                    height: 34px;
                    clicked => {
                        root.page = 2;
                    }
                }
            }
        }
        Rectangle {
            width: 100%;
            height: 1px;
            background: #e8e5db;
        }

        // ====================== CONTENT (pages overlap) ===================
        // One stretch container; the three pages sit at (0,0) and toggle.
        Rectangle {
            width: 100%;

            // ------------------------------------------------- PAGE 1 ENGINES
            Rectangle {
                visible: root.page == 0;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 14px;

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        Text {
                            text: "Engines";
                            color: #1f1e1c;
                            font-size: 24px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.engines.length + " available";
                            color: #a39e90;
                            font-size: 13px;
                        }
                    }
                    Text {
                        text: "Hardware · " + root.hw_summary;
                        color: #7a7873;
                        font-size: 13px;
                        width: 100%;
                        max-lines: 1;
                    }

                    // recommendation card
                    Rectangle {
                        width: 100%;
                        background: #ffffff;
                        border-color: #f0c4b3;
                        border-width: 1px;
                        border-radius: 14px;
                        clip: true;
                        VerticalLayout {
                            width: 100%;
                            padding: 16px;
                            spacing: 6px;
                            Text {
                                text: "Recommended for this machine";
                                color: #c2664a;
                                font-size: 12px;
                                font-weight: 600;
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    border-radius: 5px;
                                    background: #d97757;
                                }
                                Text {
                                    text: root.rec_engine + "  ·  " + root.rec_backend;
                                    color: #1f1e1c;
                                    font-size: 18px;
                                    font-weight: 700;
                                    width: 320px;
                                    max-lines: 1;
                                }
                                Text {
                                    text: "default: " + root.default_engine;
                                    color: #7a7873;
                                    font-size: 12px;
                                }
                            }
                        }
                    }

                    // engine cards
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            width: 100%;
                            spacing: 10px;
                            for engine in root.engines:
                                Rectangle {
                                    width: 100%;
                                    height: 64px;
                                    background: #ffffff;
                                    border-color: #eae7dd;
                                    border-width: 1px;
                                    border-radius: 12px;
                                    clip: true;
                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding: 12px;
                                        spacing: 12px;
                                        // status dot
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            border-radius: 5px;
                                            background: engine.present ? #4d9f5f : #e8e5db;
                                        }
                                        VerticalLayout {
                                            width: 100%;
                                            spacing: 3px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text {
                                                    text: engine.name;
                                                    color: #1f1e1c;
                                                    font-size: 15px;
                                                    font-weight: 600;
                                                    width: 190px;
                                                    max-lines: 1;
                                                }
                                                Text {
                                                    text: engine.is_default ? "★ default" : "";
                                                    color: #d97757;
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: engine.recommended ? "● recommended" : "";
                                                    color: #4d9f5f;
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: engine.present ? "installed" : "missing";
                                                    color: engine.present ? #4d9f5f : #f2903b;
                                                    font-size: 11px;
                                                }
                                            }
                                            Text {
                                                text: (engine.path != "" ? engine.path : engine.note);
                                                color: #a39e90;
                                                font-size: 12px;
                                                width: 500px;
                                                max-lines: 1;
                                            }
                                        }
                                        ClaudeButton {
                                            label: engine.present ? "Set default" : "Download";
                                            bg: engine.present ? #1f1e1c : #d97757;
                                            fg: white;
                                            radius: 8px;
                                            ty: 6px;
                                            width: 104px;
                                            height: 30px;
                                            clicked => {
                                                if (engine.present) {
                                                    root.change_engine("default", engine.name);
                                                } else {
                                                    root.change_engine("download", engine.name);
                                                }
                                            }
                                        }
                                    }
                                }
                        }
                    }
                }
            }

            // ------------------------------------------------- PAGE 2 MODELS
            Rectangle {
                visible: root.page == 1;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 14px;

                    // search + category pills
                    HorizontalLayout {
                        width: 100%;
                        spacing: 8px;
                        Rectangle {
                            width: 250px;
                            height: 34px;
                            background: #ffffff;
                            border-color: #eae7dd;
                            border-width: 1px;
                            border-radius: 10px;
                            clip: true;
                            LineEdit {
                                width: 100%;
                                height: 100%;
                                text: root.search_query;
                                placeholder-text: "Search HuggingFace";
                                edited => {
                                    root.search_query = self.text;
                                }
                            }
                        }
                        ClaudeButton {
                            label: "Search";
                            bg: #1f1e1c;
                            fg: white;
                            radius: 10px;
                            ty: 7px;
                            width: 72px;
                            height: 34px;
                            clicked => {
                                root.do_search(root.search_query);
                            }
                        }
                        ClaudeButton {
                            label: "Hot";
                            bg: root.category == "hot" ? #1f1e1c : #ffffff;
                            fg: root.category == "hot" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 52px;
                            height: 34px;
                            clicked => {
                                root.category = "hot";
                                root.change_category("hot");
                            }
                        }
                        ClaudeButton {
                            label: "Coding";
                            bg: root.category == "coding" ? #1f1e1c : #ffffff;
                            fg: root.category == "coding" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 66px;
                            height: 34px;
                            clicked => {
                                root.category = "coding";
                                root.change_category("coding");
                            }
                        }
                        ClaudeButton {
                            label: "Image";
                            bg: root.category == "image" ? #1f1e1c : #ffffff;
                            fg: root.category == "image" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 60px;
                            height: 34px;
                            clicked => {
                                root.category = "image";
                                root.change_category("image");
                            }
                        }
                        ClaudeButton {
                            label: "Video";
                            bg: root.category == "video" ? #1f1e1c : #ffffff;
                            fg: root.category == "video" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 60px;
                            height: 34px;
                            clicked => {
                                root.category = "video";
                                root.change_category("video");
                            }
                        }
                        ClaudeButton {
                            label: "Tiny";
                            bg: root.category == "tiny" ? #1f1e1c : #ffffff;
                            fg: root.category == "tiny" ? white : #7a7873;
                            bd: #eae7dd;
                            bw: 1px;
                            radius: 17px;
                            ty: 7px;
                            width: 54px;
                            height: 34px;
                            clicked => {
                                root.category = "tiny";
                                root.change_category("tiny");
                            }
                        }
                    }

                    // list / detail overlap
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        // ---- model list ----
                        Rectangle {
                            visible: !root.detail_visible;
                            width: 100%;
                            height: 100%;
                            ScrollView {
                                width: 100%;
                                height: 100%;
                                VerticalLayout {
                                    width: 100%;
                                    spacing: 8px;
                                    Text {
                                        visible: root.models_loading;
                                        text: "Loading…";
                                        color: #a39e90;
                                        font-size: 13px;
                                        width: 100%;
                                    }
                                    // header
                                    HorizontalLayout {
                                        visible: !root.models_loading;
                                        width: 100%;
                                        spacing: 6px;
                                        Text { text: "Model"; color: #a39e90; font-size: 11px; font-weight: 600; width: 170px; }
                                        Text { text: "Provider"; color: #a39e90; font-size: 11px; font-weight: 600; width: 90px; }
                                        Text { text: "Quant"; color: #a39e90; font-size: 11px; font-weight: 600; width: 66px; }
                                        Text { text: "Size"; color: #a39e90; font-size: 11px; font-weight: 600; width: 62px; }
                                        Text { text: "TTFT"; color: #a39e90; font-size: 11px; font-weight: 600; width: 44px; }
                                        Text { text: "TPOT"; color: #a39e90; font-size: 11px; font-weight: 600; width: 44px; }
                                        Text { text: "Total"; color: #a39e90; font-size: 11px; font-weight: 600; width: 48px; }
                                        Text { text: "Status"; color: #a39e90; font-size: 11px; font-weight: 600; width: 100%; }
                                    }
                                    for m in root.models:
                                        Rectangle {
                                            visible: !root.models_loading;
                                            width: 100%;
                                            height: 48px;
                                            background: #ffffff;
                                            border-color: #ece9e0;
                                            border-width: 1px;
                                            border-radius: 10px;
                                            clip: true;
                                            TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                clicked => {
                                                    root.open_model(m.repo_id);
                                                }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding: 8px;
                                                spacing: 6px;
                                                Text {
                                                    text: m.name;
                                                    color: #1f1e1c;
                                                    font-size: 13px;
                                                    font-weight: 600;
                                                    width: 170px;
                                                    max-lines: 1;
                                                }
                                                Text {
                                                    text: m.provider;
                                                    color: #7a7873;
                                                    font-size: 12px;
                                                    width: 90px;
                                                    max-lines: 1;
                                                }
                                                Text {
                                                    text: m.rec_quant;
                                                    color: #c2664a;
                                                    font-size: 12px;
                                                    width: 66px;
                                                }
                                                Text {
                                                    text: m.rec_quant_size;
                                                    color: #7a7873;
                                                    font-size: 12px;
                                                    width: 62px;
                                                }
                                                Text {
                                                    text: m.ttft;
                                                    color: #5f5e5b;
                                                    font-size: 12px;
                                                    width: 44px;
                                                }
                                                Text {
                                                    text: m.tpot;
                                                    color: #5f5e5b;
                                                    font-size: 12px;
                                                    width: 44px;
                                                }
                                                Text {
                                                    text: m.total;
                                                    color: #5f5e5b;
                                                    font-size: 12px;
                                                    width: 48px;
                                                }
                                                Text {
                                                    text: "● " + m.status_label;
                                                    color: m.status_color;
                                                    font-size: 11px;
                                                    font-weight: 600;
                                                    width: 100%;
                                                    max-lines: 1;
                                                }
                                            }
                                        }
                                }
                            }
                        }

                        // ---- model detail ----
                        Rectangle {
                            visible: root.detail_visible;
                            width: 100%;
                            height: 100%;
                            ScrollView {
                                width: 100%;
                                height: 100%;
                                VerticalLayout {
                                    width: 100%;
                                    spacing: 14px;
                                    HorizontalLayout {
                                        width: 100%;
                                        spacing: 10px;
                                        ClaudeButton {
                                            label: "‹ Back";
                                            bg: #ffffff;
                                            fg: #3d3c39;
                                            bd: #eae7dd;
                                            bw: 1px;
                                            radius: 10px;
                                            ty: 6px;
                                            width: 64px;
                                            height: 30px;
                                            clicked => {
                                                root.close_detail();
                                            }
                                        }
                                        Text {
                                            text: root.detail_repo;
                                            color: #1f1e1c;
                                            font-size: 20px;
                                            font-weight: 700;
                                            width: 480px;
                                            max-lines: 1;
                                        }
                                        Text {
                                            text: root.detail_provider;
                                            color: #a39e90;
                                            font-size: 12px;
                                        }
                                    }
                                    Text {
                                        text: root.detail_desc;
                                        color: #7a7873;
                                        font-size: 13px;
                                        width: 100%;
                                        max-lines: 2;
                                    }

                                    // quantization table (column grid)
                                    Rectangle {
                                        width: 100%;
                                        background: #ffffff;
                                        border-color: #eae7dd;
                                        border-width: 1px;
                                        border-radius: 12px;
                                        clip: true;
                                        VerticalLayout {
                                            width: 100%;
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Quantizations   ·   recommended: " + root.detail_rec_quant;
                                                color: #1f1e1c;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                spacing: 10px;
                                                Text { text: "Quant"; color: #a39e90; font-size: 11px; font-weight: 600; width: 74px; }
                                                Text { text: "Bits"; color: #a39e90; font-size: 11px; font-weight: 600; width: 48px; }
                                                Text { text: "VRAM"; color: #a39e90; font-size: 11px; font-weight: 600; width: 68px; }
                                                Text { text: "Quality"; color: #a39e90; font-size: 11px; font-weight: 600; width: 84px; }
                                                Text { text: "Status"; color: #a39e90; font-size: 11px; font-weight: 600; width: 100%; }
                                            }
                                            for q in root.quant_table:
                                                HorizontalLayout {
                                                    width: 100%;
                                                    spacing: 10px;
                                                    Text {
                                                        text: q.quant;
                                                        color: #1f1e1c;
                                                        font-size: 13px;
                                                        font-weight: 600;
                                                        width: 74px;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: q.bits;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 48px;
                                                    }
                                                    Text {
                                                        text: q.vram;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 68px;
                                                    }
                                                    Text {
                                                        text: q.quality;
                                                        color: #7a7873;
                                                        font-size: 12px;
                                                        width: 84px;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: "● " + q.status;
                                                        color: q.status_color;
                                                        font-size: 11px;
                                                        font-weight: 600;
                                                        width: 100%;
                                                        max-lines: 1;
                                                    }
                                                }
                                        }
                                    }

                                    // files & versions
                                    Rectangle {
                                        width: 100%;
                                        background: #ffffff;
                                        border-color: #eae7dd;
                                        border-width: 1px;
                                        border-radius: 12px;
                                        clip: true;
                                        VerticalLayout {
                                            width: 100%;
                                            padding: 14px;
                                            spacing: 8px;
                                            Text {
                                                text: "Files & versions";
                                                color: #1f1e1c;
                                                font-size: 14px;
                                                font-weight: 700;
                                            }
                                            for f in root.file_list:
                                                HorizontalLayout {
                                                    width: 100%;
                                                    spacing: 10px;
                                                    Text {
                                                        text: f.name;
                                                        color: #3d3c39;
                                                        font-size: 12px;
                                                        width: 100%;
                                                        max-lines: 1;
                                                    }
                                                    Text {
                                                        text: f.size;
                                                        color: #a39e90;
                                                        font-size: 11px;
                                                        width: 76px;
                                                    }
                                                }
                                        }
                                    }

                                    ClaudeButton {
                                        label: "Download (" + root.detail_rec_quant + ")  ·  fastest mirror · 32/64 threads";
                                        bg: #d97757;
                                        fg: white;
                                        radius: 12px;
                                        ty: 9px;
                                        width: 100%;
                                        height: 38px;
                                        clicked => {
                                            root.download_model(root.detail_repo, root.detail_rec_quant);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ------------------------------------------------- PAGE 3 CHAT
            Rectangle {
                visible: root.page == 2;
                width: 100%;
                height: 100%;
                VerticalLayout {
                    width: 100%;
                    height: 100%;
                    padding: 22px;
                    spacing: 12px;

                    HorizontalLayout {
                        width: 100%;
                        spacing: 10px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: #d97757;
                        }
                        Text {
                            text: root.chat_model;
                            color: #1f1e1c;
                            font-size: 15px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.chat_status;
                            color: #c2664a;
                            font-size: 12px;
                        }
                    }

                    // messages
                    ScrollView {
                        width: 100%;
                        height: 100%;
                        VerticalLayout {
                            width: 100%;
                            spacing: 10px;
                            for msg in root.chat:
                                Rectangle {
                                    width: 100%;
                                    background: msg.role == "user" ? #1f1e1c : #ffffff;
                                    border-color: msg.role == "user" ? #1f1e1c : #eae7dd;
                                    border-width: msg.role == "user" ? 0px : 1px;
                                    border-radius: 14px;
                                    clip: true;
                                    VerticalLayout {
                                        width: 100%;
                                        padding: 12px;
                                        spacing: 4px;
                                        Text {
                                            text: msg.role;
                                            color: msg.role == "user" ? #f2903b : #c2664a;
                                            font-size: 11px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            width: 100%;
                                            text: msg.content;
                                            color: msg.role == "user" ? white : #1f1e1c;
                                            font-size: 14px;
                                        }
                                    }
                                }
                        }
                    }

                    // composer
                    Rectangle {
                        width: 100%;
                        height: 48px;
                        background: #ffffff;
                        border-color: #eae7dd;
                        border-width: 1px;
                        border-radius: 12px;
                        clip: true;
                        HorizontalLayout {
                            width: 100%;
                            height: 100%;
                            padding: 8px;
                            spacing: 8px;
                            LineEdit {
                                width: 100%;
                                height: 100%;
                                text: root.chat_input;
                                placeholder-text: "Message ohllama…";
                                edited => {
                                    root.chat_input = self.text;
                                }
                            }
                            ClaudeButton {
                                label: "Send";
                                bg: #d97757;
                                fg: white;
                                radius: 8px;
                                ty: 4px;
                                width: 56px;
                                height: 32px;
                                clicked => {
                                    root.send_chat(root.chat_input);
                                    root.chat_input = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
